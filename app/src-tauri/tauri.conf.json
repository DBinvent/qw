{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QW",
  "version": "0.1.1",
  "identifier": "work.knownby.qw",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "QW",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
