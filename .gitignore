/app/src-tauri/target/

# The generated Android project. `cargo tauri android init` writes it, it is
# ~300 MB once built, and nothing in it is authored here — the one hand-edit
# worth keeping (release signing) lives in app/android-signing.patch.
# gen/schemas/ is the opposite case: small, generated once, and tracked.
/app/src-tauri/gen/android/

# Signing material and build outputs, wherever they land. Binaries ship from
# /media/lab/repo/paks (apt.dbinvent.com/paks) — never from a clone, because
# a build output in git bloats every clone forever to no one's benefit.
*.jks
*.keystore
*.apk
*.aab
